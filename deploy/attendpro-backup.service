# Daily AttendPro backup, run by attendpro-backup.timer.
# Install: sudo cp deploy/attendpro-backup.* /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now attendpro-backup.timer
[Unit]
Description=AttendPro database backup
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=attendpro
Group=attendpro
ExecStart=/srv/attendpro/app/deploy/backup.sh
Nice=10
IOSchedulingClass=idle
