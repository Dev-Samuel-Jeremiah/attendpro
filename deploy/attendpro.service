# systemd unit for AttendPro.
# Install: sudo cp deploy/attendpro.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now attendpro
[Unit]
Description=AttendPro QR attendance (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=attendpro
Group=www-data
WorkingDirectory=/srv/attendpro/app
# Creates /run/attendpro for the socket, owned by User/Group above
RuntimeDirectory=attendpro
RuntimeDirectoryMode=0750
ExecStart=/srv/attendpro/venv/bin/gunicorn attendpro.wsgi:application -c deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
# New files: readable by nginx (group www-data), not by other users
UMask=0027

# Hardening: the app may only write to its uploads folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/attendpro/media

[Install]
WantedBy=multi-user.target
