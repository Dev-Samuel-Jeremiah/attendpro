# AttendPro settings. Copy to .env next to manage.py and fill in:
#     cp .env.example .env && chmod 600 .env
# Never commit .env (it is in .gitignore). Values can't contain a # character.

# --- Core -------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# It also signs the reception QR codes: changing it invalidates codes on screen (they refresh in seconds).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=attendpro.cloud,www.attendpro.cloud
DJANGO_CSRF_TRUSTED_ORIGINS=https://attendpro.cloud,https://www.attendpro.cloud
DJANGO_TIME_ZONE=Africa/Lagos
# Hard-to-guess path for Django's built-in super-admin, e.g. platform-x7k2q/
DJANGO_ADMIN_URL=

# Address encoded in the reception QR code
ATTENDPRO_PUBLIC_URL=https://attendpro.cloud

# --- Database (PostgreSQL) ----------------------------------------------
DB_ENGINE=postgresql
DB_NAME=db_attendpro
DB_USER=attendpro
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Paystack (online plan payments) ------------------------------------
# From dashboard.paystack.com → Settings → API Keys & Webhooks. Leave blank to switch
# online payment off (the Upgrade buttons then say payment is being set up).
# Webhook URL to enter in Paystack: https://attendpro.cloud/billing/paystack/webhook/
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Files on the server -------------------------------------------------
DJANGO_STATIC_ROOT=/srv/attendpro/static
DJANGO_MEDIA_ROOT=/srv/attendpro/media
